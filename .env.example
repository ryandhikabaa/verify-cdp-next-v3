DB_USER=ryan
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=verify_cdp
DB_PORT=5432

DOTVERA_DB_USER=ryan
DOTVERA_DB_PASSWORD=
DOTVERA_DB_HOST=localhost
DOTVERA_DB_NAME=dotvera_v3
DOTVERA_DB_PORT=5432
DOTVERA_SOURCE_DB_NAME=dotvera_v2
DATABASE_URL=postgresql://ryan:@localhost:5432/dotvera_v3
QR_GENERATE_API_URL=https://authenticity-qr.pstlocal.net/api/Checking/qrcode-generate-dynamic
AUTH_SECRET=change-this-to-a-long-random-secret

# AES-256 key (32 byte) in Base64
NEXT_PUBLIC_CDP_AES_KEY_B64=RE9UVkVSQS1DRFAtU0VFRC1LRVktMjAyNi1BTFBIQVg=

# AES-CTR counter/nonce (16 byte) in Base64
NEXT_PUBLIC_CDP_AES_COUNTER_B64=RE9UVkVSQS1DVFItMjAyNgA=

DOTVERA_ADMIN_NAME=Dotvera Admin
DOTVERA_ADMIN_USERNAME=admin
DOTVERA_ADMIN_PASSWORD=admin12345
DOTVERA_ADMIN_ROLE=admin

NEXT_PUBLIC_API_URL=/api

# Opt-in API debug logging (writes to logs/api-debug.log). Set to "true" to
# enable, remove or set to "false" to disable.
DEBUG_API_LOG=false
